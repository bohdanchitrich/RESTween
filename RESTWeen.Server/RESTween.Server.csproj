<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);RS2008</NoWarn>
    <NoPackageAnalysis>true</NoPackageAnalysis>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageId>RESTween.Server</PackageId>
    <Version>1.7.9</Version>
    <Authors>Bohdan Khitrikh</Authors>
    <Product>Library</Product>
    <Description>Runtime ASP.NET Core controller generation for RESTween API interfaces using Reflection.Emit.</Description>
    <PackageTags>REST;API;ASP.NET Core;Controller;Reflection.Emit</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/bohdanchitrich/RESTween</PackageProjectUrl>
    <RepositoryUrl>https://github.com/bohdanchitrich/RESTween</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RESTween.Core\RESTween.Core.csproj" />
  </ItemGroup>

</Project>
